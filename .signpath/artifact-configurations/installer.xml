<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer" (paste into the SignPath project; slug: installer).
  The release workflow uploads a ZIP with the NSIS installer, built from the already signed Slinger.exe.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Slinger" product-version="${version}">
      <include path="Slinger-${version}-win-x64.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
