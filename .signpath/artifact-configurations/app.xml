<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "app" (paste into the SignPath project; slug: app).
  The release workflow uploads a ZIP with only the program built from this repository: Slinger.exe from
  electron-builder's win-unpacked folder. Third-party files (Electron's DLLs, prebuilt native modules) ship unsigned.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Slinger" product-version="${version}">
      <include path="Slinger.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
