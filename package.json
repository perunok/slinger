{
  "name": "slinger",
  "version": "0.1.0",
  "private": true,
  "productName": "Slinger",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "description": "Slinger: a local-first API development desktop app (Electron + TypeScript + Svelte).",
  "author": {
    "name": "Slinger",
    "email": "henokmto444@gmail.com"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "vite build && node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "node scripts/package.mjs",
    "electron:build:dir": "node scripts/package.mjs --dir",
    "rebuild:electron": "node scripts/ensure-native.mjs electron --force",
    "rebuild:node": "node scripts/ensure-native.mjs node --force",
    "pretest": "node scripts/ensure-native.mjs node",
    "test": "npm run test:main && npm run test:renderer",
    "test:main": "vitest run --config vitest.config.ts",
    "test:renderer": "vitest run --config vite.config.ts",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:main && npm run typecheck:e2e && npm run typecheck:renderer",
    "typecheck:main": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:renderer": "svelte-check --tsconfig ./tsconfig.json",
    "test:sync-it": "node scripts/ensure-native.mjs node && vitest run --config vitest.sync-it.config.ts",
    "test:e2e": "npm run build && node scripts/ensure-native.mjs electron && vitest run --config vitest.e2e.config.ts",
    "test:e2e:run": "vitest run --config vitest.e2e.config.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-xml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1",
    "@napi-rs/keyring": "^2.1.0",
    "better-sqlite3": "^12.11.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/svelte": "^5.2.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "autoprefixer": "^10.4.19",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.50.0",
    "postcss": "^8.4.40",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.1",
    "vitest": "^2.1.9"
  },
  "license": "MIT"
}
