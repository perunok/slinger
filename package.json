{
  "name": "slinger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modern local-first API development platform built with Rust, Tauri, Svelte, and Go.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:renderer": "vitest run",
    "typecheck:renderer": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "CARGO_TARGET_DIR=src-tauri/target-local tauri dev",
    "tauri:build": "CARGO_TARGET_DIR=src-tauri/target-local tauri build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-xml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1",
    "@tauri-apps/api": "^2.0.3",
    "@tauri-apps/plugin-dialog": "^2.7.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.5.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "svelte": "^5.0.0",
    "tailwindcss": "^3.4.5",
    "typescript": "^5.6.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "jsdom": "^26.0.0",
    "@testing-library/svelte": "^5.2.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/user-event": "^14.0.0",
    "svelte-check": "^4.0.0"
  }
}
