{
  "name": "slinger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slinger: a local-first API development desktop app (Electron + TypeScript + Svelte).",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:main": "node scripts/build-main.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run build:electron-renderer && npm run build:main && node scripts/ensure-native.mjs electron && electron-builder",
    "build:electron-renderer": "vite build",
    "rebuild:electron": "node scripts/ensure-native.mjs electron --force",
    "rebuild:node": "node scripts/ensure-native.mjs node --force",
    "pretest": "node scripts/ensure-native.mjs node",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "better-sqlite3": "^12.11.1",
    "uuid": "^14.0.2",
    "vanilla-jsoneditor": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "autoprefixer": "^10.4.19",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.40",
    "svelte": "^4.2.20",
    "tailwindcss": "^3.4.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.1",
    "vitest": "^2.1.9"
  },
  "main": "dist-electron/main.cjs",
  "author": "Slinger"
}
