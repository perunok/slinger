	"item": [
		{
			"name": "Country by code",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "graphql",
					"graphql": {
						"query": "query Country($code: ID!) {\n  country(code: $code) {\n    name\n    capital\n    currency\n  }\n}",
						"variables": "{\n  \"code\": \"{{countryCode}}\"\n}"
					}
				},
				"url": {
					"raw": "{{graphqlUrl}}/graphql",
					"host": [
						"{{graphqlUrl}}"
					],
					"path": [
						"graphql"
					]
				}
			},
			"response": []
		},
